    permanentPincode: $("#permanentPincode").val(),
    permanentAddress: $("#permanentAddress").val(),

    casteReligion: $("#casteReligion").val(),
    nationality: $("#nationality").val(),
    aadharNumber: $("#aadharNumber").val(),
    candidatePhoto: $("#candidatePhoto").val(),
    candidateSign: $("#candidateSign").val(),
    sslcBoard: $("#sslcBoard").val(),
    sslcTotalMarks: $("#sslcTotalMarks").val(),
