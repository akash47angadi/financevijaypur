console.log($("input[name='widow']:checked").val()+"/"+$("input[name='x_army']:checked").val());
// Format the date to day-month-year
let formattedDate = ("0" + dateObj.getDate()).slice(-2) + "-" +
                    ("0" + (dateObj.getMonth() + 1)).slice(-2) + "-" +
                    dateObj.getFullYear();

