        if ($("#dateOfBirth").val() !== "") {
            validateAge();
        }
    });
    
let cropper;
let currentTarget = ""; // To track whether it's photo or signature

function openCropper(file, target) {
  currentTarget = target;

  const reader = new FileReader();
  reader.onload = function (e) {
    const $img = $("#cropImage");

    // Full reset before setting new image
    $img.cropper?.("destroy"); // if already active
    $img.attr("src", "").removeAttr("style").removeAttr("data-cropper");

    $img.attr("src", e.target.result);
    $("#cropModal").removeClass("hidden");

    cropper = new Cropper($img[0], {
     
      viewMode: 1,
      responsive: true,
      autoCropArea: 1,
    });
  };
  reader.readAsDataURL(file);
}

const sslcOnlyJobs = [
    "Nayak/Attender",
    "Peon",
    "Driver",
    "Night-Watchman"
];

function updateEducationRequiredFields() {

    const jobName = $("#job_name").val();

    if (sslcOnlyJobs.includes(jobName)) {

        // PUC is NOT mandatory
        $(".puc_row .required-star").hide();

        // Degree is NOT mandatory
        $(".degree_row .required-star").hide();

        // SSLC remains mandatory
        $(".sslc_row .required-star").show();

    } else {

        // Normal posts
        $(".puc_row .required-star").show();
        $(".degree_row .required-star").show();

        $(".sslc_row .required-star").show();
    }
}

updateEducationRequiredFields();

$("#job_name").on("change", function () {
    updateEducationRequiredFields();
});


$("#candidatePhoto, #candidateSign").change(function () {
  let file = this.files[0];
  const id = $(this).attr("id");
  const errorBox = $("#" + id + "Error");
  const preview = $("#" + id + "Preview");
  const MAX_SIZE = 512 * 1024;

  errorBox.html("");
  preview.attr("src", "").addClass("hidden");

  if (!file) {
    errorBox.html("Please select an image.");
    return;
  } else if (!file.type.match("image.*")) {
    errorBox.html("Invalid file type.");
    return;
  } else if (file.size > MAX_SIZE) {
    errorBox.html("File should be < 512KB");
    return;
  } else {
    openCropper(file, id); // Open crop modal
  }
});

// Confirm Crop
$("#cropConfirm").click(function () {
  cropper.getCroppedCanvas().toBlob(function (blob) {
    const previewId = currentTarget + "Preview";
    const errorId = currentTarget + "Error";

    // Show preview
    const url = URL.createObjectURL(blob);
    $("#" + previewId).attr("src", url).removeClass("hidden");
    $("#" + errorId).html("");

    // Hide modal
    $("#cropModal").addClass("hidden");

    // OPTIONAL: Replace input file with cropped blob (if you use FormData)
    let fileInput = document.getElementById(currentTarget);
    let dataTransfer = new DataTransfer();
    dataTransfer.items.add(new File([blob], "cropped.png", { type: "image/png" }));
    fileInput.files = dataTransfer.files;

    // Destroy cropper
    cropper.destroy();
  }, "image/png");
});

// Cancel Crop
$("#cropCancel").click(function () {
  $("#cropModal").addClass("hidden");

  // Reset image src and remove styles
  $("#cropImage")
    .attr("src", "")
    .removeAttr("style")     // Remove inline width/height
    .removeAttr("data-cropper"); // Important if cropper data persists

  // Destroy cropper if exists
  if (cropper) {
    cropper.destroy();
    cropper = null;
  }

  // Optional: Reset aspect ratio or other flags if used
  currentTarget = "";
});


  function validateFileSize(fileInputId, errorMsgId,btn_class) {
      
        const fileInput = document.getElementById(fileInputId);
        const errorMsg = document.getElementById(errorMsgId);
        
       fileInput.addEventListener('change', function () {
        const file = this.files[0];
        const validFileTypes = ['image/jpeg', 'image/png', 'image/gif', 'application/pdf'];

        if (file) {
            if (file.size > 512 * 1024) { // 512KB
                errorMsg.textContent = "File size should be less than 512KB.";
                this.value = '';
                $("."+btn_class).attr("disabled",true);
            } else if (!validFileTypes.includes(file.type)) {
                errorMsg.textContent = "Only image and PDF files are allowed.";
                this.value = '';
                $("."+btn_class).attr("disabled",true);
            } else {
                errorMsg.textContent = '';
                $("."+btn_class).attr("disabled",false);
                
                if(file.type=="image/jpeg" || file.type=="image/png" || file.type=="image/gif")
                {
                     let reader = new FileReader();
                     reader.onload = function(e) {
                         if(fileInputId=="sslcMarksCard")
                         {
                            $("#SSLCPreview").attr("src", e.target.result).removeClass("hidden");
                         }
                         
                         if(fileInputId=="pucMarksCard")
                         {
                            $("#PUCPreview").attr("src", e.target.result).removeClass("hidden");
                         }
                         
                         if(fileInputId=="degreeMarksCard")
                         {
                            $("#DegreePreview").attr("src", e.target.result).removeClass("hidden");
                         }
                        }
                        reader.readAsDataURL(file);
                }
                else
                {
                    $("#SSLCPreview").addClass("hidden");  
                    $("#PUCPreview").addClass("hidden");
                    $("#DegreePreview").addClass("hidden");
                }
                
              
            }
        }
    });
    }

    validateFileSize('sslcMarksCard', 'sslcMarksCardError','next-btn-edu');
    validateFileSize('pucMarksCard', 'pucMarksCardError','next-btn-edu');
    validateFileSize('degreeMarksCard', 'degreeMarksCardError','next-btn-edu');
    //validateFileSize('experienceCertificate', 'experienceCertificateError');
    //validateFileSize('skillsCertificate', 'skillsCertificateError');
    
       let formData = {};

