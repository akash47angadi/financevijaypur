                    $("#degreeNameError").html(
                        "<i class='fa fa-exclamation-triangle'></i> Please Provide Other Option"
                    );

                    error++;

                } else {

                    $("#degreeNameError").html("");
                }
            }
        }


        // ==========================================
        // Degree Total Marks
        // ==========================================
        if (degreeTotalMarks == "") {

            $("#degreeTotalMarksError").html(
                "<i class='fa fa-exclamation-triangle'></i> Please Provide Total Marks for Degree"
            );

            error++;

        } else {

            $("#degreeTotalMarksError").html("");
        }


        // ==========================================
        // Degree Obtained Marks
        // ==========================================
        if (degreeObtainedMarks == "") {

            $("#degreeObtainedMarksError").html(
                "<i class='fa fa-exclamation-triangle'></i> Please Provide Obtained Marks for Degree"
            );

            error++;

        } else {

