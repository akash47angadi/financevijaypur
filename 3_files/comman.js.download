    pucTotalMarks: $("#pucTotalMarks").val(),
    pucObtainedMarks: $("#pucObtainedMarks").val(),
    pucPercentage: $("#pucPercentage").val(),
    pucCGPA: $("#pucCGPA").val(),
    degreeName: $("#degreeName").val(),
    degreeTotalMarks: $("#degreeTotalMarks").val(),
    degreeObtainedMarks: $("#degreeObtainedMarks").val(),
    degreePercentage: $("#degreePercentage").val(),
    degreeCGPA: $("#degreeCGPA").val(),
    sslcMarksCard: $("#sslcMarksCard").val(),
    pucMarksCard: $("#pucMarksCard").val(),
    degreeMarksCard: $("#degreeMarksCard").val(),
    experienceDetails: $("#experienceDetails").val(),
    computerSkills: $("#computerSkills").val(),
    skillsCertificate: $("#skillsCertificate").val(),

    languages: {
        kannada: {
            speak: $("#kannadaSpeak").is(":checked"),
            read: $("#kannadaRead").is(":checked"),
            write: $("#kannadaWrite").is(":checked"),
            DT: $("#kannadaDT").is(":checked")
        },
