$(".only_number_dec").on("input", function () {
    let value = $(this).val();

    // Allow only digits and one dot (.)
    // Remove invalid characters
    value = value.replace(/[^0-9.]/g, '');

    // Allow only one decimal point
    let parts = value.split('.');
    if (parts.length > 2) {
        value = parts[0] + '.' + parts[1];
    }

    $(this).val(value);
});


$(".only_number_special_char").keypress(function(e){
    //alert(e.which);
    charCode=e.which;
if ((charCode >= 48 && charCode <= 57 )|| charCode == 47 )
  return true;
return false;

});

$('#downloadForm').submit(function(e) {
        e.preventDefault();
        
        var isValid = true;
        
        // Mobile Number validation
        var mobileNumber = $('#mobileNumber').val();
        if (mobileNumber === '' || !/^\d{10}$/.test(mobileNumber)) {
            $('#mobileNumberError').show();
            isValid = false;
        } else {
            $('#mobileNumberError').hide();
        }
        
        // UTR Number validation
        var utrNumber = $('#utrNumber').val();
        if (utrNumber === '' || !/^\d{12}$/.test(utrNumber)) {
            $('#utrNumberError').show();
            isValid = false;
        } else {
            $('#utrNumberError').hide();
        }
        
        // Date of Birth validation
        var dob = $('#dob').val();
        if (dob === '') {
            $('#dobError').show();
            isValid = false;
        } else {
            $('#dobError').hide();
        }
        
        if (isValid) {
            // Submit the form data via AJAX or any other method
            // $.ajax({ ... });
            
            $.ajax({

          url:$(this).attr("action"),
          dataType : "JSON",
          data: $(this).serialize(),
          type: "post",
          success: function(response)
          {
            // alert(data);
             $(".loader").removeClass("d-block");
             $(".loader").addClass("d-none");
             let msg_type = '';
             if(response.code==1)
             {
                 $(".btn_download").attr("href",response.url);
                 $(".btn_download").removeClass("hidden");
                 $("#err_display").html("");
                 msg_type = 'Success';
             }
             else
             {
                $(".btn_download").addClass("hidden"); 
                $("#err_display").html("<i class='fa fa-exclamation-triangle'></i> "+response.msg);
                msg_type= 'Error';
             }
             
               $.toast({
    heading: msg_type,
    text: response.msg,
    showHideTransition: 'slide',
    position:'top-right',
    icon: msg_type
})     
            
             //$(".next-btn-payment").attr("disabled",true);
          },
          error:function( jqXHR,textStatus,errorThrown){
            alert(errorThrown);
            $(".btn_submit").attr('disabled',false);
          }


        })
            
        }
    });
    
