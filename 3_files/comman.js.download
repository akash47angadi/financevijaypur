        }*/

let pucBoard = $("#pucBoard").val();
let pucTotalMarks = $("#pucTotalMarks").val();
let pucObtainedMarks = $("#pucObtainedMarks").val();
let pucPercentage = $("#pucPercentage").val();




// =====================================================
// PUC VALIDATION
// =====================================================

if (isSSLCOnlyJob) {

    // PUC is OPTIONAL.
    // But if candidate enters any PUC information,
    // then validate the complete PUC details.

    let hasPUCData =
        pucBoard !== "" ||
        pucTotalMarks !== "" ||
        pucObtainedMarks !== "";

    if (hasPUCData) {

        // -------------------------
        // PUC Board
        // -------------------------
        if (pucBoard == "") {

            $("#pucBoardError").html(
                "<i class='fa fa-exclamation-triangle'></i> Please Provide Board for PUC"
            );

            error++;

        } else {

            $("#pucBoardError").html("");

            if (pucBoard == "others") {

                if ($("#others_puc").val() == "") {

                    $("#pucBoardError").html(
                        "<i class='fa fa-exclamation-triangle'></i> Please Provide Other Option"
                    );

                    error++;

                } else {

                    $("#pucBoardError").html("");
                }
            }
        }


        // -------------------------
        // PUC Total Marks
        // -------------------------
        if (pucTotalMarks == "") {

            $("#pucTotalMarksError").html(
                "<i class='fa fa-exclamation-triangle'></i> Please Provide Total Marks for PUC"
            );

            error++;

        } else {

            $("#pucTotalMarksError").html("");
        }


        // -------------------------
        // PUC Obtained Marks
        // -------------------------
        if (pucObtainedMarks == "") {

            $("#pucObtainedMarksError").html(
                "<i class='fa fa-exclamation-triangle'></i> Please Provide Obtained Marks for PUC"
            );

            error++;

        } else {

            $("#pucObtainedMarksError").html("");

            // Percentage is already calculated
            // by the input event above.

            if (pucPercentage < 35) {

                $("#pucObtainedMarksError").html(
                    "<i class='fa fa-exclamation-triangle'></i> PUC % Must Be Above 35 Percentage"
                );

                error++;

            } else {

                $("#pucObtainedMarksError").html("");
            }
        }

    } else {

        // =================================================
        // PUC NOT PROVIDED
        // This is perfectly valid for these jobs.
        // =================================================

        $("#pucBoardError").html("");
        $("#pucTotalMarksError").html("");
        $("#pucObtainedMarksError").html("");
        $("#pucPercentageError").html("");
    }


} else {

    // =====================================================
    // EXISTING JOBS
    // PUC IS REQUIRED
    // =====================================================

    if (pucBoard == "") {

        $("#pucBoardError").html(
            "<i class='fa fa-exclamation-triangle'></i> Please Provide Board for PUC"
        );

        error++;

    } else {

        $("#pucBoardError").html("");

        if (pucBoard == "others") {

            if ($("#others_puc").val() == "") {

                $("#pucBoardError").html(
                    "<i class='fa fa-exclamation-triangle'></i> Please Provide Other Option"
                );

                error++;

            } else {

                $("#pucBoardError").html("");
            }
        }
    }


    if (pucTotalMarks == "") {

        $("#pucTotalMarksError").html(
            "<i class='fa fa-exclamation-triangle'></i> Please Provide Total Marks for PUC"
        );

        error++;

    } else {

        $("#pucTotalMarksError").html("");
    }


    if (pucObtainedMarks == "") {

        $("#pucObtainedMarksError").html(
            "<i class='fa fa-exclamation-triangle'></i> Please Provide Obtained Marks for PUC"
        );

        error++;

    } else {

        $("#pucObtainedMarksError").html("");

        if (pucPercentage < 35) {

            $("#pucObtainedMarksError").html(
                "<i class='fa fa-exclamation-triangle'></i> PUC % Must Be Above 35 Percentage"
            );

            error++;

        } else {

            $("#pucObtainedMarksError").html("");
        }
    }
}

        let degreeName = $("#degreeName").val();
let degreeTotalMarks = $("#degreeTotalMarks").val();
let degreeObtainedMarks = $("#degreeObtainedMarks").val();
let degreePercentage = $("#degreePercentage").val();




// =====================================================
// DEGREE VALIDATION
// =====================================================

if (isSSLCOnlyJob) {

    // Degree is OPTIONAL for:
    // Attender, Driver, Security, Night-Watchman

    // Check whether candidate has entered ANY Degree data
    let hasDegreeData =
        degreeName !== "" ||
        degreeTotalMarks !== "" ||
        degreeObtainedMarks !== "";

    if (hasDegreeData) {

        // ==========================================
        // Degree Name
        // ==========================================
        if (degreeName == "") {

            $("#degreeNameError").html(
