    $("#degreeObtainedMarks").blur(function (e) {

    let degreepercentage = parseFloat($("#degreePercentage").val());
    let job_name = $("#job_name").val();
    let category = $("#casteCategory").val();
    let x_army = $("input[name='x_army']:checked").val();

    // Peon / Driver do not require Degree
    if (job_name == "Peon" || job_name == "Driver") {
        $("#degreeObtainedMarksError").html("");
        return;
    }

    // Categories / X-Army eligible for below 45%
    let relaxedDegree = (
        category == "sc" ||
        category == "st" ||
        category == "cat-1" ||
        x_army == "yes"
    );

    if (isNaN(degreepercentage)) {
        $("#degreeObtainedMarksError").html("");
        return;
    }

    if (relaxedDegree) {

        // No 45% restriction for these categories/X-Army
        $("#degreeObtainedMarksError").html("");

    } else {

        // Other categories require minimum 60%
        if (degreepercentage < 60) {
            $("#degreeObtainedMarksError").html(
                "<i class='fa fa-exclamation-triangle'></i> " +
                "Minimum Degree Percentage Must Be 60% for this Category"
            );
        } else {
            $("#degreeObtainedMarksError").html("");
        }
    }
});
    
    $(".next-btn-edu").click(function(e){ 
         let error = 0;
         let job_name = $("#job_name").val();
         let category = $("#casteCategory").val();
         
         const sslcOnlyJobs = ["Nayak/Attender", "Driver", "Peon", "Night-Watchman"];
         const isSSLCOnlyJob = sslcOnlyJobs.includes(job_name);
         
         let sslcBoard = $("#sslcBoard").val();
        if(sslcBoard == "") {
        $("#sslcBoardError").html("<i class='fa fa-exclamation-triangle'></i> Please Provide SSLC Board");
        error++;
    } else {
        $("#sslcBoardError").html("");
        if(sslcBoard == "others")
        {
            if($("#others").val()=="")
            {
                $("#sslcBoardError").html("<i class='fa fa-exclamation-triangle'></i> Please Provide Other Option");
            }
            else
            {
                $("#sslcBoardError").html("");
            }
        }
    }
            let sslcTotalMarks = $("#sslcTotalMarks").val();
        if(sslcTotalMarks == "") {
