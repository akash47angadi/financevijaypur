            write: $("#englishWrite").is(":checked"),
            DT: $("#englishDT").is(":checked")
        },
        hindi: {
            speak: $("#hindiSpeak").is(":checked"),
            read: $("#hindiRead").is(":checked"),
            write: $("#hindiWrite").is(":checked"),
            DT: $("#hindiDT").is(":checked")
        }
    }
};

}

    function displayPreview() {
