        function calculateAge(dob, today) {

    let age = today.getFullYear() - dob.getFullYear();
    let monthDifference = today.getMonth() - dob.getMonth();
    let dayDifference = today.getDate() - dob.getDate();

    if (dayDifference < 0) {
        monthDifference--;

        dayDifference += new Date(
            today.getFullYear(),
            today.getMonth(),
            0
        ).getDate();
    }

    if (monthDifference < 0) {
        age--;

        monthDifference += 12;
    }

    return {
        ageYrs: age,
        ageMonths: monthDifference,
        ageDays: dayDifference
    };
}
        
function validateAge() {

    let ageValid = true;
    let errorMsg = "";

    const category = $("#casteCategory").val();
    const gender = $("#gender").val();
    const widowStatus = $("input[name='widow']:checked").val();
    const exArmyStatus = $("input[name='x_army']:checked").val();

    const dobValue = $("#dateOfBirth").val();

    if (!dobValue) {
        $("#ageDisplay").html("");
        $("#dateOfBirthError").html(
            "<i class='fa fa-exclamation-triangle'></i> Please Provide Date of Birth"
        );
        $(".next-btn-basic").attr("disabled", true);
        return false;
    }

    // Parse DOB safely
    const dobParts = dobValue.split("-");

    const dob = new Date(
        parseInt(dobParts[0]),
        parseInt(dobParts[1]) - 1,
        parseInt(dobParts[2])
    );

    // Recruitment age reference date
    const ageDateValue = $("#dateOfBirth").data("agedate");

    let referenceDate;

    if (ageDateValue) {

        const ageDateParts = ageDateValue.split("-");

        referenceDate = new Date(
            parseInt(ageDateParts[0]),
            parseInt(ageDateParts[1]) - 1,
            parseInt(ageDateParts[2])
        );

    } else {

        referenceDate = new Date();

    }

    // Future DOB validation
    if (dob > referenceDate) {

        $("#ageDisplay").html("");

        $("#dateOfBirthError").html(
            "<i class='fa fa-exclamation-triangle'></i> Date of Birth cannot be in the future"
        );

        $(".next-btn-basic").attr("disabled", true);

        return false;
    }

    // Calculate age
    const age = calculateAge(dob, referenceDate);

    const ageInDays =
        (age.ageYrs * 365) +
        (age.ageMonths * 30) +
        age.ageDays;

    const minimumAge = 18 * 365;

    const maxAgeGM = 35 * 365;
    const maxAgeSCSTCAT1 = 40 * 365;
    const maxAgeOtherCAT = 38 * 365;
    const maxAgeGeneral = 45 * 365;

    let maxAge = 0;

    /*
     * =====================================================
     * X-ARMY RULE
     * =====================================================
     *
     * X-Army candidates are allowed maximum age of 45 years
     * irrespective of caste/category.
     */
    if (exArmyStatus === "yes") {

        maxAge = maxAgeGeneral;

        if (
            ageInDays < minimumAge ||
            ageInDays > maxAge
        ) {

            ageValid = false;

            errorMsg =
                "For X-Army candidates, age should be between 18-45 years.";

        }

    }

    /*
     * =====================================================
     * NORMAL CATEGORY RULE
     * =====================================================
     */
    else if (category === "GM") {

        maxAge = maxAgeGM;

        // Widow relaxation
        if (
            gender === "female" &&
            widowStatus === "yes"
        ) {
            maxAge += 10 * 365;
        }

        if (
            ageInDays < minimumAge ||
            ageInDays > maxAge
        ) {

            ageValid = false;

            errorMsg =
                `For GM, age relaxation will be 18-${Math.floor(maxAge / 365)} years.`;
        }

    }

    else if (
        category === "sc" ||
        category === "st" ||
        category === "cat-1"
    ) {

        maxAge = maxAgeSCSTCAT1;

        // Widow relaxation
        if (
            gender === "female" &&
            widowStatus === "yes"
        ) {
            maxAge += 10 * 365;
        }

        if (
            ageInDays < minimumAge ||
            ageInDays > maxAge
        ) {

            ageValid = false;

            errorMsg =
                `For SC/ST/CAT-1, age relaxation will be 18-${Math.floor(maxAge / 365)} years.`;
        }

    }

    else if (
        [
            "cat-2(A)",
            "cat-2(B)",
            "cat-3(A)",
            "cat-3(B)"
        ].includes(category)
    ) {

        maxAge = maxAgeOtherCAT;

        // Widow relaxation
        if (
            gender === "female" &&
            widowStatus === "yes"
        ) {
            maxAge += 10 * 365;
        }

        if (
            ageInDays < minimumAge ||
            ageInDays > maxAge
        ) {

            ageValid = false;

            errorMsg =
                `For CAT-2(A)/CAT-2(B)/CAT-3(A)/CAT-3(B), age relaxation will be 18-${Math.floor(maxAge / 365)} years.`;
        }

    }

    // Display calculated age
    $("#ageDisplay").html(
        `Age : ${age.ageYrs} Years ${age.ageMonths} Months ${age.ageDays} Days`
    );

    // Final validation result
    if (!ageValid) {

        $("#dateOfBirthError").html(
            "<i class='fa fa-exclamation-triangle'></i> " + errorMsg
        );

        $(".next-btn-basic").attr("disabled", true);

        return false;

    } else {

        $("#dateOfBirthError").html("");

        $(".next-btn-basic").attr("disabled", false);

        return true;
    }
}

$("#dateOfBirth").on("change", function () {

    const dobValue = $(this).val();

    if (!dobValue) {

        $("#ageDisplay").html("");

        $("#dateOfBirthError").html(
            "<i class='fa fa-exclamation-triangle'></i> Please Provide Date of Birth"
        );

        return;
    }

    validateAge();

});
    
