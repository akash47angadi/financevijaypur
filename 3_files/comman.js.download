    /*************************Calculate Percentage**************************************/
    function calculatePercentage(total, obtained) {
        if (total > 0 && obtained >= 0) {
            return ((obtained / total) * 100).toFixed(2);
        }
        return 0;
    }
    
     $("#sslcTotalMarks, #sslcObtainedMarks").on("input", function () {
