                category == "st" ||
                category == "cat-1") {

                if (degreePercentageValue < 45) {

                    $("#degreeObtainedMarksError").html(
                        "<i class='fa fa-exclamation-triangle'></i> For SC/ST/CAT-1 Aspirants Minimum Degree Must Be Above 45 Percentage"
                    );

                    error++;

