    ` : ''}

    ${formData.languages?.hindi ? `
      <div>
        <span class="font-medium">Hindi:</span>
        Speak: ${formData.languages.hindi.speak ? 'Yes' : 'No'}, 
        Read: ${formData.languages.hindi.read ? 'Yes' : 'No'}, 
        Write: ${formData.languages.hindi.write ? 'Yes' : 'No'}
      </div>
    ` : ''}

  </div>
</div>


    <!-- Declaration -->
    <div class="bg-white rounded-lg shadow p-4">
      <label class="flex items-start gap-2">
        <input type="checkbox" id="declaration" name="declaration" class="mt-1">
        <span>
          I, hereby declare that the information provided in this form is true and correct to the best of my knowledge and belief. I understand that any false information or misrepresentation may lead to disqualification or legal action taken by the bank.
        </span>
      </label>
      <span class="text-red-500 text-sm" id="declarationError"></span>
    </div>
  </div>
`;


    $("#previewContent").html(previewContent);

    // Load photo and signature preview
    formData.candidatePhotoFile = document.getElementById('candidatePhoto').files[0];
    formData.candidateSignFile = document.getElementById('candidateSign').files[0];

    const photoFile = formData.candidatePhotoFile;
    const signFile = formData.candidateSignFile;

    if (photoFile) {
        const photoReader = new FileReader();
        photoReader.onload = function (e) {
            const photoImg = document.createElement('img');
            photoImg.src = e.target.result;
            photoImg.alt = "Candidate Photo";
            photoImg.className = "h-24 w-24 object-cover rounded";
            document.getElementById("photoPreview").appendChild(photoImg);
        };
        photoReader.readAsDataURL(photoFile);
    }

    if (signFile) {
        const signReader = new FileReader();
        signReader.onload = function (e) {
            const signImg = document.createElement('img');
            signImg.src = e.target.result;
            signImg.alt = "Candidate Signature";
            signImg.className = "h-12 w-24 object-contain";
            document.getElementById("signPreview").appendChild(signImg);
        };
        signReader.readAsDataURL(signFile);
    }
} 






